rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        "your-admin-email@example.com"
      ];
    }
    match /portalMeta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /portalContent/{section}/items/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && section == 'lost' && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid);
      allow create: if isAdmin() || (request.auth != null && section in ['complaints','lost'] && request.resource.data.ownerId == request.auth.uid && request.resource.data.keys().hasAll(['title','description','date','ownerId']));
    }
  }
}
